{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "northstar-learning",
  "main": "worker.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "assets": {
    "directory": "./mvp-public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "COURSES",
      "bucket_name": "northstar-scorm-courses"
    }
  ]
}
