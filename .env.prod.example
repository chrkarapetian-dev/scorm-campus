# Copy to .env.prod on the server; never commit that file.
# Generate APP_KEY with: php artisan key:generate --show (or see README).
APP_KEY=
APP_URL=https://example.com
# Keep true for HTTPS. Set false only during an initial HTTP IP-address launch.
SESSION_SECURE_COOKIE=true
DB_DATABASE=scorm_campus
DB_USERNAME=scorm
DB_PASSWORD=
DB_ROOT_PASSWORD=
UPLOAD_TOKEN=
# Absolute directory containing course1 ... course11, copied separately to the server.
COURSES_HOST_PATH=/srv/scorm-campus/courses
PROD_HTTP_PORT=8081
# Optional: without a key the assistant is unavailable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT=45
AI_QUESTION_LIMIT=10
AI_QUESTION_MAX_LENGTH=100
AI_MAX_CHUNKS=4

# Heuristic assignment detection: estimates at or above this value receive 0.
ASSIGNMENT_AI_THRESHOLD=50
