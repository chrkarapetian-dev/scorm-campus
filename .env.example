APP_NAME="Ուսում"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
# Port the app is published on by docker compose.
APP_PORT=8080

APP_LOCALE=hy
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# Inside Docker the host is always "db" (set in compose.yaml). These values are
# for running PHP on your machine against the container, on FORWARD_DB_PORT.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=scorm_campus
DB_USERNAME=scorm
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
FORWARD_DB_PORT=3307

SESSION_DRIVER=database
# Set to true when the site is served over HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Secret required to upload SCORM packages. Without it, uploads are open locally
# and refused when APP_ENV=production.
UPLOAD_TOKEN=

# Optional. Without a key the assistant and the grader use built-in demo responses.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Comma-separated proxy IPs or "*", when running behind a TLS-terminating proxy.
TRUSTED_PROXIES=
