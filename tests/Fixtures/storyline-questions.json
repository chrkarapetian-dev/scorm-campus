        {
          "id": "6mveFjmrsi4",
          "lmsId": "Slide6",
          "title": "Ըստ «Մեր ընդհանուր ապագան» զեկույցի տրամաբանության՝ ինչպե՞ս են բաշխված գլոբալ բնապահպանական խնդիրների պատճառները աշխարհի Հյուսիսի և Հարավի միջև: ",
          "interactions": [
            {
              "id": "5a5yi3eKDOV",
              "lmsId": "MultiChoice",
              "lmstext": "Ըստ «Մեր ընդհանուր ապագան» զեկույցի տրամաբանության՝ ինչպե՞ս են բաշխված գլոբալ բնապահպանական խնդիրների պատճառները աշխարհի Հյուսիսի և Հարավի միջև: ",
              "type": "multiplechoice",
              "choices": [
                {
                  "kind": "choice",
                  "id": "choice_6TKIarz2ZNZ",
                  "lmstext": "Ա․ Խնդիրները պայմանավորված են բացառապես Հարավի զարգացող երկրների արդյունաբերականացմամբ:"
                },
                {
                  "kind": "choice",
                  "id": "choice_5ceBT6KQQUv",
                  "lmstext": "Բ․ Դրանք արդյունք են Հարավի հսկայական աղքատության և Հյուսիսում սպառման ու արտադրության ոչ կայուն ձևերի: "
                },
                {
                  "kind": "choice",
                  "id": "choice_6DHu5WqFelK",
                  "lmstext": "Գ․ Դրանք բխում են միայն Հյուսիսի զարգացած երկրների բնակչության արագ աճից:"
